{
  "name": "icpc-trainer",
  "version": "0.0.0",
  "description": "Local-first ICPC training app for judge account tracking, contest discovery, and upsolving workflows.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Alejandro Mc Ewen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amchp/icpc-trainer.git"
  },
  "bugs": {
    "url": "https://github.com/amchp/icpc-trainer/issues"
  },
  "homepage": "https://github.com/amchp/icpc-trainer#readme",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=24 <26",
    "pnpm": ">=10.33.4"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,green \"ICPC_TRAINER_PORT=3774 pnpm dev:server\" \"VITE_API_BASE_URL=http://127.0.0.1:3774 pnpm --filter @icpc-trainer/web dev:open\"",
    "dev:reset": "node scripts/reset-dev-server.mjs",
    "dev:web": "pnpm --filter @icpc-trainer/web dev",
    "dev:server": "pnpm --filter @icpc-trainer/server dev",
    "catalog:sync": "pnpm --filter @icpc-trainer/server catalog:sync",
    "catalog:sync:task": "pnpm --filter @icpc-trainer/server catalog:sync:task",
    "build": "pnpm -r build",
    "typecheck": "tsc -b",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @icpc-trainer/web test:e2e"
  },
  "devDependencies": {
    "@types/node": "26.1.0",
    "concurrently": "^10.0.3",
    "shadcn": "4.13.0",
    "typescript": "6.0.3"
  }
}
