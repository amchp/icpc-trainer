{
  "name": "@icpc-trainer/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "main": "dist/src/main.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local src/main.ts",
    "build": "tsc -b tsconfig.json",
    "start": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local dist/src/main.js",
    "db:migrate:prod": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local dist/src/migrate.js",
    "catalog:sync": "tsx --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local src/catalogSync.ts",
    "catalog:sync:task": "tsx --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local src/catalogSyncTask.ts",
    "catalog:sync:prod": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local dist/src/catalogSync.js",
    "catalog:sync:task:prod": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local dist/src/catalogSyncTask.js",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@clerk/backend": "^3.19.0",
    "@icpc-trainer/api": "workspace:*",
    "@icpc-trainer/db": "workspace:*",
    "@icpc-trainer/shared": "workspace:*",
    "@libsql/client": "^0.18.0",
    "@t3-oss/env-core": "^0.13.11",
    "@trpc/server": "11.19.0",
    "drizzle-orm": "0.45.3",
    "effect": "3.22.2",
    "impit": "^0.14.5",
    "posthog-node": "^5.53.0",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@icpc-trainer/tsconfig": "workspace:*",
    "@types/node": "26.6.2",
    "@types/ws": "^8.18.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
