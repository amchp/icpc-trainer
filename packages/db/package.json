{
  "name": "@icpc-trainer/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "node ./scripts/ensure-local-db-dir.mjs && drizzle-kit migrate --config drizzle.config.ts",
    "db:studio": "node ./scripts/ensure-local-db-dir.mjs && drizzle-kit studio --config drizzle.config.ts",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@icpc-trainer/shared": "workspace:*",
    "@libsql/client": "^0.17.4",
    "drizzle-orm": "0.45.2",
    "effect": "3.22.1"
  },
  "devDependencies": {
    "@icpc-trainer/tsconfig": "workspace:*",
    "@types/node": "26.1.2",
    "drizzle-kit": "0.31.10",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
